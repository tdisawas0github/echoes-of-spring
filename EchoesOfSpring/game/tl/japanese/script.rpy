# ============================================================================
# Japanese Translation — Script (Dialogue & Narration)
# ============================================================================

# ============================================================================
#  CHAPTER 1 — 新しい始まり
# ============================================================================

# game/script.rpy:62
translate japanese start_49205feb:

    # n "The bus lurches to a stop. Through the dusty window you see cherry-blossom petals swirling above a quiet main street."
    n "バスが揺れながら停まった。埃っぽい窓越しに、静かな大通りの上で舞い散る桜の花びらが見える。"

# game/script.rpy:65
translate japanese start_128ff9cb:

    # n "Welcome to Hanamachi — population 3,200 — the town you'll call home for the next year while you finish your studies."
    n "花街へようこそ——人口三千二百人——この一年間、学業を終えるまであなたが暮らす町だ。"

# game/script.rpy:68
translate japanese start_10173382:

    # n "But first…"
    n "でも、まずは……"

# game/script.rpy:72
translate japanese start_5c8a9d3b:

    # mc "So this is Hanamachi… Smaller than I expected."
    mc "ここが花街か……思ったより小さいな。"

# game/script.rpy:74
translate japanese start_0f4cc92f:

    # n "You step off the bus with a single suitcase and a hand-drawn map your grandmother mailed you."
    n "スーツケースひとつと、おばあちゃんが送ってくれた手描きの地図を持ってバスを降りる。"

# game/script.rpy:77
translate japanese start_2cfa9e62:

    # n "The spring air is sweet with blossoms. Two buildings stand out on the main street:"
    n "春の空気は花の香りで甘い。大通りにふたつの建物が目立つ。"

# game/script.rpy:80
translate japanese start_16b00bd5:

    # n "A cozy café called {b}Petal Brew{/b}, its windows glowing warm orange…"
    n "窓が暖かいオレンジ色に輝く、居心地のよいカフェ{b}「ペタル・ブリュー」{/b}……"

# game/script.rpy:81
translate japanese start_6fbc51e3:

    # n "…and a narrow bookshop called {b}Ink & Pages{/b}, its shelves visible through ivy-framed glass."
    n "……そして蔦に縁取られたガラス越しに棚が見える、細長い書店{b}「インク＆ページズ」{/b}。"

# game/script.rpy:85
translate japanese first_choice_cf012075:

    # n "Where do you go first?" nointeract
    n "まず、どこへ行く？" nointeract

# game/script.rpy:101
translate japanese cafe_first_a1515924:

    # n "A bell chimes as you push open the door. The scent of freshly ground coffee wraps around you."
    n "ドアを開けると鈴の音が鳴る。挽きたてのコーヒーの香りに包まれる。"

# game/script.rpy:106
translate japanese cafe_first_5a848661:

    # s "Welcome to Petal Brew! You must be new — I know every face in this town."
    s "ペタル・ブリューへようこそ！　新しい人でしょ——この町の顔は全部覚えてるもん。"

# game/script.rpy:107
translate japanese cafe_first_23934142:

    # s "I'm Sakura. Barista, amateur painter, professional overthinker."
    s "私はさくら。バリスタで、趣味の画家で、プロの考えすぎ屋。"

# game/script.rpy:109
translate japanese cafe_first_37679d1b:

    # mc "I'm [player_name]. I just moved here for school."
    mc "僕は[player_name]。学校のためにここに引っ越してきたんだ。"

# game/script.rpy:111
translate japanese cafe_first_87a35f6d:

    # s "A newcomer! Let me make you my special lavender latte — on the house."
    s "新入りさん！　私の特製ラベンダーラテを作ってあげる——お店のおごりよ。"

# game/script.rpy:116
translate japanese cafe_first_76eeb324:

    # s "Most people are suspicious of lavender in coffee. I like you already!"
    s "ラベンダー入りのコーヒーって怪しむ人が多いのに。もう好きになっちゃった！"

# game/script.rpy:121
translate japanese cafe_first_fb43e44d:

    # s "A purist! Respectable."
    s "こだわり派ね！　尊敬するわ。"

# game/script.rpy:124
translate japanese cafe_first_688aed1a:

    # s "No rush — the door's always open!"
    s "急がなくていいよ——いつでもドアは開いてるから！"

# game/script.rpy:127
translate japanese cafe_first_9fe1217e:

    # n "Sakura hums a melody while she works. You notice watercolor paintings covering every wall — sunsets, flowers, the town square."
    n "さくらは鼻歌を歌いながら作業する。壁一面に水彩画が飾られている——夕焼け、花、町の広場。"

# game/script.rpy:130
translate japanese cafe_first_51ac8a5e:

    # mc "Did you paint all of these?"
    mc "これ、全部あなたが描いたの？"

# game/script.rpy:132
translate japanese cafe_first_e284cf7a:

    # s "Guilty as charged. Painting keeps me sane between espresso shots."
    s "バレたか。エスプレッソの合間に絵を描くのが私の正気の保ち方なの。"

# game/script.rpy:143
translate japanese bookshop_first_285442ca:

    # n "The door creaks open to reveal floor-to-ceiling shelves overflowing with books. A cat sleeps on a stack of paperbacks."
    n "ドアがきしみながら開くと、天井まで届く本棚に本があふれている。文庫本の山の上で猫が眠っている。"

# game/script.rpy:148
translate japanese bookshop_first_cee22cfd:

    # a "…Oh. A customer."
    a "……あ。お客さんだ。"

# game/script.rpy:150
translate japanese bookshop_first_0e8efb7d:

    # n "A young man with reading glasses looks up from behind a cluttered counter, a half-finished crossword in front of him."
    n "読書用の眼鏡をかけた青年が、散らかったカウンターの向こうから顔を上げる。前には半分解きかけのクロスワードパズル。"

# game/script.rpy:153
translate japanese bookshop_first_3c201fb3:

    # a "Sorry — I don't get many visitors. I'm Akira. This is my shop."
    a "ごめん——あまりお客さんが来なくて。僕はアキラ。ここは僕の店だよ。"

# game/script.rpy:155
translate japanese bookshop_first_4401167e:

    # mc "I'm [player_name]. I just arrived in town."
    mc "僕は[player_name]。この町に来たばかりなんだ。"

# game/script.rpy:157
translate japanese bookshop_first_bd8b9d2f:

    # a "Hanamachi is quiet. Perfect for reading."
    a "花街は静かだよ。読書にぴったりだ。"

# game/script.rpy:162
translate japanese bookshop_first_e1f65203:

    # a "Hmm… Try this."
    a "うーん……これを読んでみて。"

# game/script.rpy:163
translate japanese bookshop_first_6a3bedb7:

    # n "He hands you a slim novel with a faded cover: {i}Letters from a Small Town{/i}."
    n "彼は色あせた表紙の薄い小説を手渡す。{i}「小さな町からの手紙」{/i}。"

# game/script.rpy:165
translate japanese bookshop_first_fa638c14:

    # a "It's about someone who moves somewhere new and discovers the place has its own kind of magic. Seemed fitting."
    a "新しい場所に引っ越した人が、その土地ならではの不思議さを見つける話。ぴったりだと思って。"

# game/script.rpy:170
translate japanese bookshop_first_3d450f2b:

    # a "I stopped counting at four thousand. The cat makes it hard to do inventory."
    a "四千冊で数えるのをやめたよ。猫がいると棚卸しが難しくてね。"

# game/script.rpy:174
translate japanese bookshop_first_99484734:

    # a "Take your time. The cat's name is Hemingway, by the way."
    a "ゆっくりしていって。ちなみに猫の名前はヘミングウェイ。"

# game/script.rpy:185
translate japanese apartment_first_b626e1db:

    # n "You decide to settle in first. The apartment is small but clean — a single room above a bakery."
    n "まずは落ち着くことにする。アパートは小さいけど清潔だ——パン屋の上のワンルーム。"

# game/script.rpy:188
translate japanese apartment_first_72718024:

    # mc "Home sweet home… I guess."
    mc "ここが新しい我が家か……まあ、そういうことにしよう。"

# game/script.rpy:190
translate japanese apartment_first_8a6ae54e:

    # n "From the window you can see the whole main street. The café and bookshop beckon."
    n "窓からは大通りが一望できる。カフェと書店が手招きしている。"

# game/script.rpy:193
translate japanese apartment_first_bb2e5d84:

    # n "Maybe you'll explore tomorrow."
    n "明日、探検してみよう。"

# game/script.rpy:201
translate japanese day1_continue_9ee41848:

    # n "Evening falls. You unpack your suitcase and sit by the window."
    n "夕暮れが訪れる。スーツケースを開けて、窓辺に座る。"

# game/script.rpy:202
translate japanese day1_continue_bff54602:

    # n "Cherry-blossom petals drift past the glass. The town is quiet."
    n "桜の花びらがガラスの向こうを漂っていく。町は静かだ。"

# game/script.rpy:204
translate japanese day1_continue_c0fee38c:

    # mc "Maybe this year won't be so bad after all."
    mc "案外、この一年も悪くないかもしれないな。"

# game/script.rpy:206
translate japanese day1_continue_81274651:

    # n "You set an alarm and drift off to sleep."
    n "アラームをセットして、眠りに落ちる。"

# ============================================================================
#  CHAPTER 2 — 馴染む日々
# ============================================================================

# game/script.rpy:217
translate japanese chapter2_6d67ddad:

    # n "Day two. The morning air is crisp and the street is already alive with shopkeepers setting out signs."
    n "二日目。朝の空気は澄んでいて、通りでは店主たちが看板を出し始めている。"

# game/script.rpy:220
translate japanese chapter2_f51fbced:

    # n "You have the whole day free before classes start on Monday."
    n "月曜日に授業が始まるまで、丸一日自由だ。"

# game/script.rpy:223
translate japanese chapter2_81a045c6:

    # n "How do you spend your Saturday?" nointeract
    n "土曜日をどう過ごす？" nointeract

# game/script.rpy:243
translate japanese cafe_day2_3dd320e7:

    # s "[player_name]! You came back — or is this your first time?"
    s "[player_name]！　また来てくれた——それとも初めて？"

# game/script.rpy:245
translate japanese cafe_day2_0a4fd89f:

    # mc "First time, actually."
    mc "実は初めてなんだ。"

# game/script.rpy:247
translate japanese cafe_day2_9890e5c3:

    # s "Then you {i}definitely{/i} need a lavender latte."
    s "だったら{i}絶対{/i}ラベンダーラテを飲まなきゃ。"

# game/script.rpy:251
translate japanese cafe_day2_3f81d8c5:

    # s "Hey, the Spring Festival is this weekend. I'm doing a live-painting booth. You should stop by!"
    s "ねえ、今週末は春祭りなの。私、ライブペインティングのブースをやるの。ぜひ来てよ！"

# game/script.rpy:254
translate japanese cafe_day2_d45da490:

    # mc "I'd like that."
    mc "行きたいな。"

# game/script.rpy:266
translate japanese bookshop_day2_07d12178:

    # a "[player_name]. You actually came."
    a "[player_name]。本当に来たんだ。"

# game/script.rpy:268
translate japanese bookshop_day2_bcefb94a:

    # mc "You sound surprised."
    mc "驚いてるみたいだね。"

# game/script.rpy:270
translate japanese bookshop_day2_bb673b77:

    # a "I am. Not many people seek out bookshops twice."
    a "うん。本屋を二度訪ねる人はあまりいないから。"

# game/script.rpy:274
translate japanese bookshop_day2_0205611b:

    # a "The Spring Festival is coming up. I'm running a poetry reading corner. If you're interested."
    a "もうすぐ春祭りだよ。僕は詩の朗読コーナーをやるんだ。興味があれば。"

# game/script.rpy:277
translate japanese bookshop_day2_e780966f:

    # mc "I might check it out."
    mc "覗いてみようかな。"

# game/script.rpy:287
translate japanese park_day2_5ec88e65:

    # n "The park sits at the edge of town, wrapped in cherry trees. A small pond reflects the pink canopy."
    n "公園は町の端にあり、桜の木に囲まれている。小さな池がピンクの天蓋を映している。"

# game/script.rpy:290
translate japanese park_day2_f1fcc0f2:

    # n "You sit on a bench and breathe. For the first time in months, your mind is quiet."
    n "ベンチに座って深呼吸する。何か月ぶりかに、心が静かだ。"

# game/script.rpy:293
translate japanese park_day2_0efbc79d:

    # n "After a while, you notice a flyer pinned to a tree:"
    n "しばらくすると、木に貼られたチラシに気づく。"

# game/script.rpy:294
translate japanese park_day2_b78a60c0:

    # n "{b}Hanamachi Spring Festival — Volunteers Needed!{/b}"
    n "{b}花街春祭り——ボランティア募集中！{/b}"

# game/script.rpy:299
translate japanese park_day2_299f3f47:

    # n "You pocket the flyer. Maybe it's a good way to meet people."
    n "チラシをポケットに入れる。人と知り合ういい機会かもしれない。"

# game/script.rpy:303
translate japanese park_day2_fcbc01d8:

    # n "You enjoy the silence a while longer before heading home."
    n "もうしばらく静けさを楽しんでから、家路につく。"

# game/script.rpy:311
translate japanese festival_help_889ae47e:

    # n "You find the festival committee setting up stalls in the town square."
    n "町の広場で祭りの実行委員が屋台を準備しているのを見つける。"

# game/script.rpy:312
translate japanese festival_help_b9e779b2:

    # n "An older woman hands you a hammer and points at a half-built booth."
    n "年配の女性がハンマーを渡し、半分できかけのブースを指さす。"

# game/script.rpy:314
translate japanese festival_help_38e79578:

    # n "While you work, two familiar faces appear."
    n "作業していると、見覚えのある二人が現れる。"

# game/script.rpy:319
translate japanese festival_help_f8c8d8d6:

    # s "Oh! [player_name]'s helping too!"
    s "あっ！　[player_name]も手伝ってるんだ！"

# game/script.rpy:321
translate japanese festival_help_373a3e42:

    # a "…Good to see more volunteers."
    a "……ボランティアが増えるのはいいことだ。"

# game/script.rpy:323
translate japanese festival_help_93ea0602:

    # n "The three of you spend the afternoon building booths, stringing lights, and arguing about banner colours."
    n "三人で午後いっぱい、ブースを組み立て、電飾を吊るし、横断幕の色について言い合う。"

# game/script.rpy:329
translate japanese festival_help_0180b7e9:

    # s "This is going to be the best festival yet!"
    s "今年は最高の祭りになるよ！"

# game/script.rpy:331
translate japanese festival_help_57f63d26:

    # a "You said that last year."
    a "去年も同じこと言ってたよ。"

# game/script.rpy:333
translate japanese festival_help_66694aca:

    # s "And I was right!"
    s "で、合ってたでしょ！"

# game/script.rpy:341
translate japanese chapter2_evening_d3b65ecf:

    # n "That night, your phone buzzes with a message."
    n "その夜、スマホにメッセージが届く。"

# game/script.rpy:344
translate japanese chapter2_evening_fce9612c:

    # s "{i}(text message){/i} Hey [player_name]! Thanks for today. See you at the festival? 🌸"
    s "{i}（メッセージ）{/i} ねえ[player_name]！　今日はありがとう。祭りで会える？ 🌸"

# game/script.rpy:352
translate japanese chapter2_evening_8608bf80:

    # a "{i}(text message){/i} [player_name]. I set aside a book I think you'd like. Come by whenever."
    a "{i}（メッセージ）{/i} [player_name]。気に入りそうな本を取っておいたよ。いつでも来て。"

# game/script.rpy:360
translate japanese chapter2_evening_56b469e7:

    # n "No messages yet. The town still feels new."
    n "まだメッセージはない。この町はまだ新鮮に感じる。"

# game/script.rpy:362
translate japanese chapter2_evening_a69ad4d2:

    # n "You fall asleep to the distant sound of wind chimes."
    n "遠くの風鈴の音を聞きながら眠りに落ちる。"

# ============================================================================
#  CHAPTER 3 — 春祭り
# ============================================================================

# game/script.rpy:373
translate japanese chapter3_a678fdef:

    # n "The day of the Spring Festival arrives. Hanamachi is transformed — paper lanterns sway from every post, and stalls line the streets with food, crafts, and games."
    n "春祭りの日がやってきた。花街は一変した——紙の提灯がどの柱からも揺れ、屋台が食べ物や工芸品やゲームで通りを埋め尽くす。"

# game/script.rpy:377
translate japanese chapter3_4502e35d:

    # n "The whole town seems to be here."
    n "町中の人がここに集まっているようだ。"

# game/script.rpy:380
translate japanese festival_choice_aa32b8f9:

    # n "Where do you go?" nointeract
    n "どこへ行く？" nointeract

# game/script.rpy:396
translate japanese festival_sakura_bd702eb3:

    # s "[player_name]! You came!"
    s "[player_name]！　来てくれたんだ！"

# game/script.rpy:398
translate japanese festival_sakura_34a241ff:

    # n "Sakura stands behind a large canvas, brush in hand, a crowd of children watching."
    n "さくらは大きなキャンバスの前に立ち、筆を手に持っている。子どもたちが見守っている。"

# game/script.rpy:401
translate japanese festival_sakura_f3d39053:

    # s "I'm painting the festival in real time. Wanna help? I need someone to hold the palette."
    s "祭りをリアルタイムで描いてるの。手伝ってくれない？　パレットを持ってくれる人が必要なの。"

# game/script.rpy:408
translate japanese festival_sakura_27871195:

    # n "You hold her palette while she paints. Her eyes light up when the colours blend just right."
    n "彼女が描く間、パレットを持つ。色がちょうどよく混ざると、彼女の目が輝く。"

# game/script.rpy:411
translate japanese festival_sakura_bab8b49d:

    # s "You know, most people think art is about talent. But it's really about paying attention."
    s "ねえ、ほとんどの人は芸術は才能だと思ってる。でも本当は、よく見ることなの。"

# game/script.rpy:414
translate japanese festival_sakura_74ff1ced:

    # s "You seem like someone who pays attention, [player_name]."
    s "[player_name]は、よく見てくれる人みたいね。"

# game/script.rpy:416
translate japanese festival_sakura_882dff10:

    # mc "Thanks, Sakura. That means a lot."
    mc "ありがとう、さくら。すごく嬉しいよ。"

# game/script.rpy:418
translate japanese festival_sakura_a0481847:

    # n "She smiles — warm as the lantern light."
    n "彼女は微笑む——提灯の灯りのように温かく。"

# game/script.rpy:423
translate japanese festival_sakura_1ac5b331:

    # n "You lean against a post and watch her paint. There's something calming about the way she moves."
    n "柱に寄りかかって彼女が描くのを見る。彼女の動きにはどこか落ち着くものがある。"

# game/script.rpy:433
translate japanese festival_akira_dc88257f:

    # a "I didn't think you'd come to the poetry corner."
    a "詩の朗読コーナーに来てくれるとは思わなかった。"

# game/script.rpy:435
translate japanese festival_akira_56c3991c:

    # mc "Why not?"
    mc "なんで？"

# game/script.rpy:437
translate japanese festival_akira_616e68f9:

    # a "Poetry is an acquired taste. Like black coffee."
    a "詩は好き嫌いが分かれるからね。ブラックコーヒーみたいに。"

# game/script.rpy:439
translate japanese festival_akira_3980a7ef:

    # n "The corner is a quiet alcove away from the noise, lit by string lights. A few listeners sit on cushions."
    n "そのコーナーは喧騒から離れた静かなスペースで、イルミネーションに照らされている。数人の聴衆がクッションに座っている。"

# game/script.rpy:442
translate japanese festival_akira_d3aff5cb:

    # a "I'm about to read one of my own. If you don't mind."
    a "今から自作の詩を読もうと思うんだ。よかったら。"

# game/script.rpy:448
translate japanese festival_akira_d1ca61e4:

    # a "{i}We are letters waiting to be read, pages pressed between the days, ink still wet from words unsaid — quiet in our quiet ways.{/i}"
    a "{i}僕らは読まれるのを待つ手紙、日々の間に挟まれた頁、言えなかった言葉のインクはまだ乾かない——静かな者たちの、静かなやり方で。{/i}"

# game/script.rpy:453
translate japanese festival_akira_2b1e7ea2:

    # mc "That was beautiful, Akira."
    mc "とても綺麗だったよ、アキラ。"

# game/script.rpy:455
translate japanese festival_akira_82cf70b2:

    # a "…Thank you. I don't usually share my own work."
    a "……ありがとう。自分の作品を人に見せることはあまりないんだ。"

# game/script.rpy:457
translate japanese festival_akira_d7c19f40:

    # n "For a moment, behind the glasses and the careful distance, you see something open and vulnerable."
    n "一瞬、眼鏡と慎重な距離の向こうに、素直で傷つきやすいものが見えた。"

# game/script.rpy:462
translate japanese festival_akira_73e3c6db:

    # a "All right."
    a "わかった。"

# game/script.rpy:463
translate japanese festival_akira_be39eefd:

    # n "He reads softly. The words linger in the air like smoke from a candle."
    n "彼は静かに読む。言葉はロウソクの煙のように空気の中に漂う。"

# game/script.rpy:472
translate japanese festival_solo_ed541985:

    # n "You wander through the stalls, tasting mochi, watching a goldfish scooping game, listening to a folk band."
    n "屋台を巡り、餅を味わい、金魚すくいを眺め、民謡バンドに耳を傾ける。"

# game/script.rpy:475
translate japanese festival_solo_4581c364:

    # n "It's nice, but a small part of you wonders what Sakura and Akira are up to."
    n "楽しいけれど、心のどこかでさくらとアキラが何をしているか気になる。"

# game/script.rpy:479
translate japanese festival_solo_c536cef1:

    # n "You catch a glimpse of Sakura painting across the square. She waves."
    n "広場の向こうでさくらが絵を描いているのが見える。彼女が手を振る。"

# game/script.rpy:484
translate japanese festival_solo_68e4e9ac:

    # n "You spot Akira reading under a string of lights. He gives you a brief nod."
    n "イルミネーションの下でアキラが朗読しているのを見つける。彼が軽くうなずく。"

# game/script.rpy:494
translate japanese festival_evening_9f1bcd1f:

    # n "As night falls, the sky fills with paper lanterns released from the river bank."
    n "夜が訪れると、川岸から放たれた紙の提灯が空を埋め尽くす。"

# game/script.rpy:497
translate japanese festival_evening_cdff89af:

    # n "Hanamachi glows gold against the dark hills."
    n "花街は暗い丘を背景に金色に輝く。"

# game/script.rpy:512
translate japanese lanterns_sakura_958d795b:

    # s "Hey, [player_name]. Come watch the lanterns with me?"
    s "ねえ、[player_name]。一緒に提灯を見ない？"

# game/script.rpy:514
translate japanese lanterns_sakura_6e102e12:

    # n "You stand side by side at the riverbank. The lanterns drift upward like earthbound stars."
    n "川岸に並んで立つ。提灯は地上の星のように舞い上がっていく。"

# game/script.rpy:517
translate japanese lanterns_sakura_24669143:

    # s "You know what they say — if you make a wish on a lantern, it'll come true."
    s "提灯に願いをかけると叶うって言うでしょ。"

# game/script.rpy:520
translate japanese lanterns_sakura_b4294b53:

    # mc "What would you wish for?"
    mc "何を願うの？"

# game/script.rpy:522
translate japanese lanterns_sakura_3c549935:

    # s "…I think my wish already came true. Someone new to share this with."
    s "……私の願いはもう叶ったかな。一緒にこれを共有できる新しい人がいるってこと。"

# game/script.rpy:532
translate japanese lanterns_akira_0aa28230:

    # a "[player_name]. The view is better from the bridge."
    a "[player_name]。橋からの方がよく見えるよ。"

# game/script.rpy:534
translate japanese lanterns_akira_06d2bc4f:

    # n "You follow Akira to a stone bridge where the lanterns float directly beneath you, reflections doubling the light."
    n "アキラについて石橋へ行く。提灯がすぐ足元を流れ、水面の反射が光を倍にする。"

# game/script.rpy:537
translate japanese lanterns_akira_457c24ea:

    # a "I come here every year. It's always been… solitary."
    a "毎年ここに来るんだ。いつも……ひとりだった。"

# game/script.rpy:539
translate japanese lanterns_akira_a26607b6:

    # mc "Not this year."
    mc "今年は違うよ。"

# game/script.rpy:541
translate japanese lanterns_akira_2e5e00ac:

    # a "…No. Not this year."
    a "……うん。今年は違う。"

# game/script.rpy:552
translate japanese lanterns_both_105e4603:

    # s "There you are! Come on, the lanterns are starting!"
    s "いた！　早く、提灯が上がり始めるよ！"

# game/script.rpy:554
translate japanese lanterns_both_84868953:

    # a "She's been looking for you. I just happened to be here."
    a "彼女がずっと君を探してたんだ。僕はたまたまここにいただけ。"

# game/script.rpy:556
translate japanese lanterns_both_7c0f8b0b:

    # n "The three of you watch the sky fill with floating light."
    n "三人で空が浮かぶ灯りで満たされるのを眺める。"

# game/script.rpy:558
translate japanese lanterns_both_c3abdfd1:

    # s "Best. Festival. Ever."
    s "史上。最高の。お祭り。"

# game/script.rpy:560
translate japanese lanterns_both_1f206870:

    # a "…I have to admit, it's up there."
    a "……認めざるを得ないね。かなり良かった。"

# game/script.rpy:566
translate japanese lanterns_alone_8fe64726:

    # n "You watch the lanterns alone from your apartment window."
    n "アパートの窓からひとりで提灯を眺める。"

# game/script.rpy:567
translate japanese lanterns_alone_46565616:

    # n "They're beautiful. But you feel like you're watching from the outside."
    n "綺麗だ。でも、外側から眺めているような気がする。"

# game/script.rpy:570
translate japanese lanterns_alone_e7926e53:

    # mc "Maybe I should put myself out there more…"
    mc "もっと外に出るべきかもしれないな……"

# ============================================================================
#  CHAPTER 4 — 岐路
# ============================================================================

# game/script.rpy:581
translate japanese chapter4_425718f3:

    # n "Weeks pass. Spring deepens into early summer. You settle into a rhythm — classes, study sessions, and visits to the café and bookshop."
    n "数週間が過ぎる。春は初夏へと深まっていく。授業、勉強会、カフェや書店への訪問——リズムが生まれる。"

# ---- SAKURA ROUTE ----

# game/script.rpy:601
translate japanese sakura_route_ea48353e:

    # n "You've been spending more and more evenings at Petal Brew after closing, watching Sakura paint."
    n "閉店後、ペタル・ブリューでさくらが絵を描くのを見ながら過ごす夜が増えている。"

# game/script.rpy:604
translate japanese sakura_route_a3f6ba2d:

    # s "[player_name], can I ask you something?"
    s "[player_name]、ひとつ聞いてもいい？"

# game/script.rpy:606
translate japanese sakura_route_1bf60051:

    # mc "Of course."
    mc "もちろん。"

# game/script.rpy:608
translate japanese sakura_route_4ebcb925:

    # s "I got accepted into an art program in the city. A summer intensive. It's an incredible opportunity."
    s "都会の美術プログラムに合格したの。夏の集中コース。すごいチャンスなの。"

# game/script.rpy:611
translate japanese sakura_route_55fbeae6:

    # s "But… I'd have to leave Hanamachi for three months."
    s "でも……三か月間、花街を離れなきゃいけないの。"

# game/script.rpy:630
translate japanese sakura_ending_good_909d8a24:

    # s "You really mean that?"
    s "本当にそう思ってくれるの？"

# game/script.rpy:632
translate japanese sakura_ending_good_57cfeb20:

    # mc "I do. Your art deserves to be seen by more than just Hanamachi."
    mc "うん。さくらの絵は、花街だけじゃなくもっと多くの人に見てもらうべきだよ。"

# game/script.rpy:634
translate japanese sakura_ending_good_c7bf004a:

    # n "Sakura sets down her brush and looks at you — really looks at you."
    n "さくらは筆を置いて、あなたを見つめる——本当に、見つめる。"

# game/script.rpy:636
translate japanese sakura_ending_good_94232324:

    # s "You're the first person who's ever said that without any 'but' attached."
    s "『でも』をつけずにそう言ってくれたのは、あなたが初めてだよ。"

# game/script.rpy:639
translate japanese sakura_ending_good_37746f96:

    # s "When I come back… can we watch the lanterns again? Just us?"
    s "帰ってきたら……また一緒に提灯を見ない？　二人だけで？"

# game/script.rpy:641
translate japanese sakura_ending_good_d6374454:

    # mc "It's a date."
    mc "約束だよ。"

# game/script.rpy:643
translate japanese sakura_ending_good_9b2526f2:

    # n "She smiles — that wide, paint-smudged smile — and the café feels warmer than it ever has."
    n "彼女は微笑む——あの大きな、絵の具がついた笑顔——そしてカフェがいつもよりずっと温かく感じる。"

# game/script.rpy:648
translate japanese sakura_ending_good_80152722:

    # n "{b}ENDING: Colours of Tomorrow{/b}"
    n "{b}エンディング：明日の色彩{/b}"

# game/script.rpy:649
translate japanese sakura_ending_good_9f29945b:

    # n "Sakura leaves for the city, and you exchange letters all summer — real paper letters, each one decorated with her sketches."
    n "さくらは都会へ旅立ち、夏の間ずっと手紙を交換する——本物の紙の手紙で、一通一通に彼女のスケッチが添えられている。"

# game/script.rpy:651
translate japanese sakura_ending_good_39dee81b:

    # n "When autumn comes and the bus pulls into Hanamachi, she's the first one off."
    n "秋が来てバスが花街に着くと、彼女が真っ先に降りてくる。"

# game/script.rpy:653
translate japanese sakura_ending_good_c3b808b0:

    # n "She's carrying a new canvas under her arm. When she turns it around, it's a painting of you — sitting in Petal Brew, illuminated by lantern light."
    n "彼女は腕に新しいキャンバスを抱えている。裏返すと、それはあなたの絵——ペタル・ブリューで提灯の灯りに照らされて座っている姿だった。"

# game/script.rpy:656
translate japanese sakura_ending_good_a602874e:

    # n "Some distances only make the heart more vivid."
    n "距離が離れるほど、心はより鮮やかになることもある。"

# game/script.rpy:665
translate japanese sakura_ending_bittersweet_dcc81357:

    # s "I… I don't know. Leaving is scary."
    s "私……わからない。離れるのは怖い。"

# game/script.rpy:667
translate japanese sakura_ending_bittersweet_e17d07f9:

    # n "You see the conflict in her eyes — the pull of ambition against the comfort of home."
    n "彼女の目に葛藤が見える——野心の引力と、故郷の安心感の間で揺れている。"

# game/script.rpy:670
translate japanese sakura_ending_bittersweet_cee28bbe:

    # s "Maybe you're right. Maybe I should stay."
    s "あなたの言う通りかも。やっぱり残ろうかな。"

# game/script.rpy:672
translate japanese sakura_ending_bittersweet_af3c5a19:

    # n "She stays. The summer is lovely — long evenings painting together, lazy mornings at the café."
    n "彼女は残る。夏は素敵だ——一緒に絵を描く長い夜、カフェでの穏やかな朝。"

# game/script.rpy:675
translate japanese sakura_ending_bittersweet_26b67abb:

    # n "But sometimes, when she looks at the horizon, you see a question she never asks."
    n "でも時々、彼女が地平線を見つめると、決して口にしない問いかけが見える。"

# game/script.rpy:680
translate japanese sakura_ending_bittersweet_975f2e86:

    # n "{b}ENDING: Still Waters{/b}"
    n "{b}エンディング：静かな水面{/b}"

# game/script.rpy:681
translate japanese sakura_ending_bittersweet_2a3d01b2:

    # n "Life in Hanamachi is gentle. Sakura keeps painting, and you keep watching. The café never changes."
    n "花街での暮らしは穏やかだ。さくらは描き続け、あなたは見守り続ける。カフェは変わらない。"

# game/script.rpy:683
translate japanese sakura_ending_bittersweet_a03e8e11:

    # n "It's peaceful. It's safe. But on quiet nights, you wonder what colours she might have found in the city."
    n "平和だ。安全だ。でも静かな夜、都会で彼女がどんな色を見つけたのだろうと思うことがある。"

# game/script.rpy:685
translate japanese sakura_ending_bittersweet_5b881581:

    # n "Some doors, once closed, stay closed."
    n "一度閉じた扉は、閉じたままのこともある。"

# ---- AKIRA ROUTE ----

# game/script.rpy:696
translate japanese akira_route_1ddbee6f:

    # n "You've been spending your afternoons at Ink & Pages. Akira has started saving a chair for you by the window."
    n "午後はインク＆ページズで過ごすようになった。アキラは窓際の椅子をあなたのために取っておいてくれる。"

# game/script.rpy:699
translate japanese akira_route_c4a98618:

    # a "[player_name]. I want to show you something."
    a "[player_name]。見せたいものがあるんだ。"

# game/script.rpy:701
translate japanese akira_route_5cb15b1a:

    # n "He pulls a manuscript from a drawer — handwritten pages, hundreds of them."
    n "彼は引き出しから原稿を取り出す——手書きのページが何百枚も。"

# game/script.rpy:704
translate japanese akira_route_49a1bf23:

    # a "I've been writing a novel. For three years. No one's read it."
    a "小説を書いているんだ。三年間ずっと。誰にも読ませたことがない。"

# game/script.rpy:706
translate japanese akira_route_df496303:

    # mc "You want me to read it?"
    mc "僕に読んでほしいの？"

# game/script.rpy:708
translate japanese akira_route_0c79ab07:

    # a "I want… someone's honest opinion. Before I decide whether to send it to a publisher."
    a "……正直な意見がほしいんだ。出版社に送るかどうか決める前に。"

# game/script.rpy:728
translate japanese akira_ending_good_2db6e337:

    # n "You stay up all night reading. The novel is about a small-town shopkeeper who befriends a stranger and learns to open up."
    n "一晩中読み続ける。小説は小さな町の店主が見知らぬ人と友達になり、心を開くことを学ぶ物語だ。"

# game/script.rpy:731
translate japanese akira_ending_good_d7671877:

    # n "It's beautiful. Quiet, honest, and deeply human."
    n "美しい。静かで、正直で、深く人間的だ。"

# game/script.rpy:733
translate japanese akira_ending_good_c0333531:

    # mc "Akira… this is extraordinary."
    mc "アキラ……これはすごいよ。"

# game/script.rpy:735
translate japanese akira_ending_good_e561a250:

    # a "…You think so?"
    a "……そう思う？"

# game/script.rpy:737
translate japanese akira_ending_good_aceea018:

    # mc "I know so. Send it."
    mc "確信してる。出版社に送りなよ。"

# game/script.rpy:739
translate japanese akira_ending_good_e77afdee:

    # n "For the first time, you see Akira smile — really smile. It transforms his whole face."
    n "初めて、アキラが微笑むのを見た——本当の笑顔。顔全体が変わる。"

# game/script.rpy:742
translate japanese akira_ending_good_0f5ea18c:

    # a "Thank you. For reading. For staying. For…"
    a "ありがとう。読んでくれて。いてくれて。それに……"

# game/script.rpy:744
translate japanese akira_ending_good_f6334725:

    # a "…For paying attention."
    a "……ちゃんと見てくれて。"

# game/script.rpy:748
translate japanese akira_ending_good_0c7ef3fe:

    # n "{b}ENDING: Between the Lines{/b}"
    n "{b}エンディング：行間に書かれたもの{/b}"

# game/script.rpy:749
translate japanese akira_ending_good_1d33a4ae:

    # n "Akira sends the manuscript, and months later, a small publisher picks it up."
    n "アキラは原稿を送り、数か月後、小さな出版社が手に取る。"

# game/script.rpy:751
translate japanese akira_ending_good_08ad89a1:

    # n "The dedication reads: {i}'For [player_name] — who read me before anyone else did.'{/i}"
    n "献辞にはこう書かれている。{i}「[player_name]へ——誰よりも先に僕を読んでくれた人へ。」{/i}"

# game/script.rpy:753
translate japanese akira_ending_good_ccc032b1:

    # n "On the day the first copy arrives, you sit together in the shop with Hemingway purring between you, the words on the page a mirror of everything unspoken."
    n "初版が届いた日、二人で店に座る。ヘミングウェイが二人の間で喉を鳴らし、ページの言葉は語られなかったすべてを映している。"

# game/script.rpy:756
translate japanese akira_ending_good_e0a7cf58:

    # n "Some stories only need one reader to become real."
    n "本物になるために、たった一人の読者だけを必要とする物語もある。"

# game/script.rpy:765
translate japanese akira_ending_bittersweet_928ab98f:

    # a "You're probably right."
    a "……たぶん、君の言う通りだね。"

# game/script.rpy:767
translate japanese akira_ending_bittersweet_65296ee8:

    # n "He slides the manuscript back into the drawer. The lock clicks."
    n "彼は原稿を引き出しに戻す。錠がカチッと閉まる。"

# game/script.rpy:769
translate japanese akira_ending_bittersweet_b989437a:

    # a "Forget I mentioned it."
    a "今の話は忘れて。"

# game/script.rpy:771
translate japanese akira_ending_bittersweet_570e57e3:

    # n "The distance returns to his eyes. You keep visiting, but something has shifted — a wall rebuilt brick by brick."
    n "彼の目に距離が戻る。通い続けるけれど、何かが変わった——レンガ一つ一つで壁が積み直されていく。"

# game/script.rpy:776
translate japanese akira_ending_bittersweet_5b75c49a:

    # n "{b}ENDING: Unfinished Pages{/b}"
    n "{b}エンディング：未完のページ{/b}"

# game/script.rpy:777
translate japanese akira_ending_bittersweet_bbdc88ca:

    # n "Akira never sends the manuscript. Ink & Pages stays the same — quiet, dusty, beautiful."
    n "アキラは原稿を送らなかった。インク＆ページズは変わらない——静かで、埃っぽくて、美しい。"

# game/script.rpy:779
translate japanese akira_ending_bittersweet_4cd2039d:

    # n "You graduate and leave Hanamachi wondering what his novel was really about."
    n "卒業して花街を去る。彼の小説が本当は何について書かれていたのか、ずっと気になったまま。"

# game/script.rpy:781
translate japanese akira_ending_bittersweet_60826962:

    # n "Years later, in a secondhand shop in another city, you find a slim book with a familiar name on the spine."
    n "何年も後、別の街の古本屋で、背表紙に見覚えのある名前が書かれた薄い本を見つける。"

# game/script.rpy:783
translate japanese akira_ending_bittersweet_d4f64e80:

    # n "You buy it. You never open it."
    n "買った。でも、開くことはなかった。"

# game/script.rpy:784
translate japanese akira_ending_bittersweet_db6532de:

    # n "Some stories are easier left unread."
    n "読まないままの方が楽な物語もある。"

# ---- FRIENDSHIP ROUTE ----

# game/script.rpy:796
translate japanese friendship_route_d635f44b:

    # n "Spring turns to summer, and the three of you have become inseparable — coffee at Petal Brew, reading at Ink & Pages, long walks under the cherry trees."
    n "春が夏に変わり、三人は離れられない仲になった——ペタル・ブリューでコーヒー、インク＆ページズで読書、桜の木の下の長い散歩。"

# game/script.rpy:800
translate japanese friendship_route_29734ae7:

    # s "[player_name], Akira and I were talking…"
    s "[player_name]、アキラと話してたんだけど……"

# game/script.rpy:802
translate japanese friendship_route_ae36cf4b:

    # a "Don't make it sound like a conspiracy."
    a "陰謀みたいに言わないでくれ。"

# game/script.rpy:804
translate japanese friendship_route_d11e220e:

    # s "We want to do something for the Summer Festival. Together. An art-and-poetry exhibit. Your help would mean the world."
    s "夏祭りで何かしたいの。三人で。アートと詩の展覧会。あなたが手伝ってくれたら、すごく嬉しい。"

# game/script.rpy:820
translate japanese friendship_ending_49de418f:

    # n "The three of you spend weeks preparing. Sakura paints, Akira writes, and you bring it all together."
    n "三人で何週間もかけて準備する。さくらが描き、アキラが書き、あなたがすべてをまとめる。"

# game/script.rpy:823
translate japanese friendship_ending_511f7c5f:

    # n "On festival night, the exhibit draws the biggest crowd Hanamachi has ever seen."
    n "祭りの夜、展覧会は花街史上最大の人だかりを集めた。"

# game/script.rpy:826
translate japanese friendship_ending_c150106e:

    # s "We actually did it!"
    s "本当にやったね！"

# game/script.rpy:828
translate japanese friendship_ending_a6a6dd24:

    # a "Against all reasonable expectations."
    a "あらゆる合理的な予想に反してね。"

# game/script.rpy:830
translate japanese friendship_ending_c0662beb:

    # n "Under the lanterns, surrounded by art and words and laughter, you realise something:"
    n "提灯の下、芸術と言葉と笑い声に囲まれて、気づくことがある。"

# game/script.rpy:833
translate japanese friendship_ending_e74c5951:

    # n "Love isn't always romantic. Sometimes it's two people who make a small town feel like the whole world."
    n "愛は必ずしもロマンチックとは限らない。小さな町を世界全体のように感じさせてくれる、二人の存在であることもある。"

# game/script.rpy:838
translate japanese friendship_ending_b2e49953:

    # n "{b}ENDING: Three Colours{/b}"
    n "{b}エンディング：三つの色{/b}"

# game/script.rpy:839
translate japanese friendship_ending_13f66f98:

    # n "The exhibit becomes an annual tradition. Sakura's paintings hang beside Akira's poems, and your name is on every programme as co-curator."
    n "展覧会は毎年の恒例となった。さくらの絵はアキラの詩と並んで飾られ、すべてのプログラムに共同キュレーターとしてあなたの名前が載っている。"

# game/script.rpy:842
translate japanese friendship_ending_17a412d2:

    # n "Hanamachi stays small. But with friends like these, it never feels that way."
    n "花街は小さいままだ。でもこの友達がいれば、そう感じることはない。"

# game/script.rpy:851
translate japanese friendship_ending_quiet_6d5d6c9b:

    # n "You watch from the crowd as Sakura and Akira unveil their exhibit. It's wonderful."
    n "観衆の中からさくらとアキラが展覧会を披露するのを見る。素晴らしい。"

# game/script.rpy:854
translate japanese friendship_ending_quiet_20ebb5e8:

    # n "They wave at you from across the square, and you wave back."
    n "広場の向こうから二人が手を振り、あなたも振り返す。"

# game/script.rpy:858
translate japanese friendship_ending_quiet_b04dd494:

    # n "{b}ENDING: Gentle Distance{/b}"
    n "{b}エンディング：優しい距離{/b}"

# game/script.rpy:859
translate japanese friendship_ending_quiet_4d58ce9c:

    # n "You stay close to both of them, but always a step back. It's comfortable. It's safe."
    n "二人との距離は近い。でもいつも一歩引いている。心地いい。安全だ。"

# game/script.rpy:861
translate japanese friendship_ending_quiet_1092c380:

    # n "When you leave Hanamachi, you carry two friendships that shaped you in quiet, lasting ways."
    n "花街を離れるとき、静かに、でも確かにあなたを形作った二つの友情を持っていく。"

# ---- SOLO ROUTE ----

# game/script.rpy:872
translate japanese solo_route_30a2de3b:

    # n "The weeks pass quietly. You study, attend class, and keep mostly to yourself."
    n "数週間が静かに過ぎる。勉強して、授業に出て、ほとんど一人で過ごす。"

# game/script.rpy:875
translate japanese solo_route_c7b88a12:

    # n "Hanamachi is peaceful, but you haven't quite found your place in it."
    n "花街は穏やかだけれど、まだ自分の居場所を見つけられていない。"

# game/script.rpy:878
translate japanese solo_route_456eb746:

    # n "On a warm evening, you sit by your window and watch the sunset paint the rooftops gold."
    n "暖かい夕方、窓辺に座り、夕日が屋根を金色に染めるのを見る。"

# game/script.rpy:881
translate japanese solo_route_3894d76e:

    # mc "There's still time. I don't have to figure everything out today."
    mc "まだ時間はある。今日すべてを見つけなくてもいい。"

# game/script.rpy:885
translate japanese solo_route_e017ae8c:

    # n "{b}ENDING: Open Road{/b}"
    n "{b}エンディング：開かれた道{/b}"

# game/script.rpy:886
translate japanese solo_route_f1a35f3b:

    # n "You finish the year and leave Hanamachi with good grades and a quiet appreciation for small-town life."
    n "一年を終え、良い成績と小さな町の暮らしへの静かな感謝を胸に花街を去る。"

# game/script.rpy:888
translate japanese solo_route_ee1699fd:

    # n "No grand romance, no dramatic goodbye — just the memory of cherry blossoms and the knowledge that some chapters are bridges to the next."
    n "壮大な恋愛も、劇的な別れもない——ただ桜の記憶と、ある章は次の章への架け橋だという知恵だけ。"

# game/script.rpy:891
translate japanese solo_route_6335baa3:

    # n "The road ahead is wide open."
    n "この先の道は大きく開かれている。"

